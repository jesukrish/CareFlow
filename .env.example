# CareFlow AI - Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/careflow
DB_USERNAME=careflow
DB_PASSWORD=careflow123

# Inter-Service URLs (defaults work for local development)
PATIENT_SERVICE_URL=http://localhost:8081
BED_SERVICE_URL=http://localhost:8082

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=30
